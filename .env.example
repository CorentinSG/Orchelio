# =============================================================================
# Orchelio — example environment file
#
# Copy this file to `.env` before starting the application:
#
#   cp .env.example .env
#
# `.env` is never committed to Git. This example file is, so it must never
# contain a real secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Application identity
# -----------------------------------------------------------------------------
# Product name shown throughout the interface. Leave as "Orchelio".
NEXT_PUBLIC_APP_NAME=Orchelio

# "demo" enables the demonstration warning banners and the fictional-data
# notices. Use "development" or "production" only once real safeguards exist.
NEXT_PUBLIC_APP_ENV=demo

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local SQLite file. The path is relative to the project root.
# Moving to PostgreSQL later means replacing this URL and the datasource
# provider in prisma/schema.prisma — see docs/ARCHITECTURE.md.
DATABASE_URL="file:./prisma/orchelio-demo.db"

# -----------------------------------------------------------------------------
# Artificial intelligence
# -----------------------------------------------------------------------------
# "mock"      : simulated Claude Analyst and Claude Reviewer. No network call,
#               no API key, no cost. This is what the demonstration ships with,
#               and what every automated test runs against.
# "local"     : a model running on this machine writes the summary's wording.
#               Needs LOCAL_MODEL_URL and LOCAL_MODEL_NAME below. Every fact is
#               still derived by Orchelio, not by the model.
# "mistral"   : Mistral's hosted API writes the summary's wording (ADR-0027).
#               Needs MISTRAL_API_KEY below. EU processing; each call is billed
#               to the firm's Mistral account, recorded to the fraction of a
#               cent and marked as an estimate until the invoice agrees.
# "anthropic" : reserved for a later phase. Not implemented yet.
AI_PROVIDER=mock

# Server-side only. Never prefix this with NEXT_PUBLIC_, or the key would be
# sent to every visitor's browser. Leave empty for the demonstration.
ANTHROPIC_API_KEY=

# The firm's Mistral key (https://console.mistral.ai). Server-side only, same
# rule as above. Only read when AI_PROVIDER=mistral; selecting that provider
# without a key stops the application from starting rather than silently
# falling back to the simulation. Verify key and connectivity with:
#   npm run ai:smoke
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# A model on this machine (only read when AI_PROVIDER=local)
# -----------------------------------------------------------------------------
# Where a local model server is listening. Ollama's default is shown.
#
# It must be a literal loopback address — 127.0.0.1 or ::1. "localhost" is
# refused on purpose: a name is resolved by the machine, and an entry in
# /etc/hosts or a DNS server could point it somewhere else without anything
# noticing. Anything that is not on this machine stops the application from
# starting rather than failing on the first matter. See ADR-0023.
LOCAL_MODEL_URL=http://127.0.0.1:11434

# Which model that server should load, e.g. "qwen2.5:7b" or "llama3.1:8b".
# Recorded against every analysis, so an output kept for years can still be
# explained by what produced it.
LOCAL_MODEL_NAME=
