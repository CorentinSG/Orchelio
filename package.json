{
  "name": "orchelio-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Orchelio Demo \u2014 a configurable AI operating system for law firms.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "verify": "npm run lint && npm run typecheck && npm run docs:check && npm run acceptance:check && npm run skills:check && npm run confidentiality:check && npm run test",
    "verify:full": "npm run verify && npm run build && npm run test:e2e",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "reset-demo": "prisma migrate reset --force",
    "codemap": "node scripts/codemap.mjs",
    "graph": "graphify . --code-only && graphify cluster-only .",
    "graph:update": "graphify update . --code-only || npm run graph",
    "graph:explain": "graphify explain",
    "graph:query": "graphify query",
    "queries": "ORCHELIO_LOG_QUERIES=1 next dev",
    "harness:doctor": "node scripts/doctor.mjs",
    "check": "npm run lint && npm run typecheck && npm run docs:check && npm run acceptance:check && npm run skills:check && npm run confidentiality:check && npm run test",
    "postinstall": "prisma generate",
    "docs:check": "node scripts/docs-check.mjs",
    "skills:check": "node scripts/skills-check.mjs",
    "skills:firm-scope": "node .claude/skills/orchelio-firm-scope/scripts/audit.mjs",
    "acceptance:check": "node scripts/acceptance-check.mjs",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "confidentiality:check": "node scripts/confidentiality-check.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
