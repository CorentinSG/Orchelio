{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run verify:full)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run seed)",
      "Bash(npm run codemap)",
      "Bash(npm run graph:*)",
      "Bash(npm run harness:doctor)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate)",
      "Bash(npm install)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma migrate status)",
      "Bash(npx tsc --noEmit)",
      "Bash(graphify explain:*)",
      "Bash(graphify query:*)",
      "Bash(graphify path:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Read(//home/user/Orchelio/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(npm run reset-demo)",
      "Bash(npm run db:reset)",
      "Bash(npx prisma migrate reset:*)",
      "Read(./.env)"
    ]
  },
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
